# Set to your deployed origin before production deployment, e.g. https://your-domain.example
NEXT_PUBLIC_SITE_URL=
# Optional display setting; set true only when you are actually accepting opportunities
NEXT_PUBLIC_AVAILABLE_FOR_WORK=false
# Contact form is shown only when all three values below are set.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# Required for distributed rate limiting on the contact endpoint.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
